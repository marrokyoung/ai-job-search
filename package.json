{
  "name": "us-job-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun run test:domain && bun run test:database",
    "test:domain": "bun test packages/domain/tests",
    "test:database": "node --import tsx --test packages/database/tests/*.test.ts",
    "seed:synthetic": "node --import tsx packages/database/src/seed-cli.ts",
    "typecheck": "bun run typecheck:domain && bun run typecheck:database",
    "typecheck:domain": "tsc --noEmit -p packages/domain/tsconfig.json",
    "typecheck:database": "tsc --noEmit -p packages/database/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
